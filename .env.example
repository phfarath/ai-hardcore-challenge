# Copie para .env e preencha. Nunca commite o .env.
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_CHAT_MODEL=
# Modelos de raciocinio (ex.: gpt-6-luna) so aceitam ferramentas com OPENAI_REASONING_EFFORT=none.
# Deixe vazio para modelos que nao aceitam esse parametro (ex.: gpt-4o).
OPENAI_REASONING_EFFORT=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=chroma_data
