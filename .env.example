# Copie para .env e preencha. Nunca commite o .env.
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_CHAT_MODEL=
# Modelos de raciocinio (ex.: gpt-6-luna) so aceitam ferramentas com OPENAI_REASONING_EFFORT=none.
# Deixe vazio para modelos que nao aceitam esse parametro (ex.: gpt-4o).
OPENAI_REASONING_EFFORT=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=chroma_data
# development = emissor local de tokens (POST /dev/token, chave efemera). O padrao e production,
# que exige AUTH_ISSUER e AUTH_JWKS_URL (https) do provedor de identidade e recusa o emissor local.
APP_ENV=development
AUTH_AUDIENCE=getnet-support-api
AUTH_ISSUER=
AUTH_JWKS_URL=
# estado das conversas (SQLite) e retencao configuravel (nao e prazo regulatorio)
STATE_PATH=state_data/state.db
CONVERSATION_RETENTION_HOURS=72
